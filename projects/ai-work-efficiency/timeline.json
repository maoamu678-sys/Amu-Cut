{
  "schemaVersion": "0.1",
  "project": "Amu Cut",
  "style": "tech-business-card",
  "styleName": "科技商业卡片风",
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "pixelFormat": "yuv420p"
  },
  "source": {
    "video": "input/talking-head.mp4",
    "srt": "input/talking-head.srt"
  },
  "audio": {
    "music": "off",
    "voicePriority": true,
    "approvedSfxPeakDbtp": -2.3,
    "sfxMode": "automatic-or-user-requested",
    "referencePool": "audio/references"
  },
  "brollPolicy": {
    "freshBatch": true,
    "fullScreenSeconds": [
      1,
      3
    ],
    "strangerFaces": "avoid-blur-or-replace",
    "sourceMode": "online-search-with-attribution",
    "provider": "wikimedia-commons",
    "userUrlsOverrideAutomaticSearch": true,
    "downloadFreshBatch": true
  },
  "scenes": []
}
